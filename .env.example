# Climate Search API URL (example)
# For local development
VITE_CLIMATE_API_URL=http://localhost:8000
VITE_PORTFOLIO_API_URL=http://localhost:8000

# For production, set to your deployed backend URL
# VITE_CLIMATE_API_URL=https://your-api-domain.com
# VITE_PORTFOLIO_API_URL=https://your-portfolio-backend-domain.com

# Private area login (/login → /me). Server-only — never prefix with VITE_.
# Put real values in .env.local for dev and in Vercel project env vars for prod.
# ADMIN_PASSWORD must be 12+ chars. Changing either value signs out all sessions.
# SESSION_SECRET must be 32+ chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Trainer history database (Neon Postgres via Vercel Marketplace). Server-only.
# Vercel sets this automatically once Neon is connected; copy it into .env.local for dev + migrations.
DATABASE_URL=
